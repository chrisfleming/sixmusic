pkgname=sixmusic
pkgver=0.4.0
pkgrel=1
pkgdesc='Listen to BBC Radio 6 Music and see what is playing'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-multimedia' 'qt6-wayland' 'ffmpeg')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/sixmusic "$pkgdir/usr/bin/sixmusic"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/sixmusic.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/sixmusic.svg"
  install -Dm644 "$startdir/sixmusic.desktop" "$pkgdir/usr/share/applications/sixmusic.desktop"
}
